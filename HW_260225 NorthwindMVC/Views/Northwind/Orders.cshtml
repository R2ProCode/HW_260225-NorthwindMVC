@using HW_260225_NorthwindMVC.Models
@model NorthwindViewModel
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Orders</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <h1 class="col md-1 mt-3">@Model.TodaysDate.ToLongDateString()</h1>
        <div class="row mt-3">
            <div class="col md-12">
                <table class="table table-hover table-striped table-bordered" style="--bs-table-bg: #ffffff; --bs-table-striped-bg: #fffdf0; --bs-table-accent-bg: #fef08a; border-color: #d4af37;">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Order Date</th>
                            <th>Ship Address</th>
                            <th>Ship Name</th>
                            <th>Ship Country</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (Order order in Model.Orders)
                        {
                            <tr>
                                <td>@order.Id</td>
                                <td>@order.OrderDate.ToLongDateString()</td>
                                <td>@order.ShipAddress</td>
                                <td>@order.ShipName</td>
                                <td>@order.ShipCountry</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
