@using HW_260225_NorthwindMVC.Models
@model NorthwindViewModel
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>OrderDetails</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <h1 class="col md-1 mt-3">Orders placed in 1997</h1>
        <div class="row mt-3">
            <div class="col md-12">
                <table class="table table-hover table-striped table-bordered" style="--bs-table-bg: #ffffff; --bs-table-striped-bg: #fffdf0; --bs-table-accent-bg: #fef08a; border-color: #d4af37;">
                    <thead>
                        <tr>
                            <th>Order Id</th>
                            <th>Product Id</th>
                            <th>Unit Price</th>
                            <th>Quantity</th>
                            <th>Order Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (OrderDetail orderDetails in Model.OrderDetails)
                        {
                            <tr>
                                <td>@orderDetails.OrderId</td>
                                <td>@orderDetails.ProductId</td>
                                <td>@orderDetails.UnitPrice.ToString("C")</td>
                                <td>@orderDetails.Quantity</td>
                                <td>@orderDetails.OrderDate.ToLongDateString()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
